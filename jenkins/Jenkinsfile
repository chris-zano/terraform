pipeline {
    agent { label 'terraform-agent'}

    stages {

        stage("Checkout") {
            steps {
                // Checkout source code from git
                git branch: 'master', url: 'https://github.com/chris-zano/terraform.git'
            }
        }

        stage("Create terraform.tfbackend") {
            steps {
               withCredentials(
                string[credentialsId: 'bucket', variable: 'BUCKET'],
                string[credentialsId: 'key', variable: 'KEY'],
                string[credentialsId: 'region', variable: 'REGION'],
                string[credentialsId: 'ami_id', variable: 'AMI_ID'],
                string[credentialsId: 'key_pair_name', variable: 'KEY_PAIR_NAME'],
                ) {
                    sh 'echo "bucket = $BUCKET" > terraform.tfbackend'
                    sh 'echo "key = $KEY" >> terraform.tfbackend'
                    sh 'echo "region = $REGION" >> terraform.tfbackend'
                    sh 'echo "ami_id = $AMI_ID" >> terraform.tfvars'
                    sh 'echo "insance_type = t3.micro" >> terraform.tfvars'
                    sh 'echo "key_name = $KEY_PAIR_NAME" >> terraform.tfvars'
                    sh 'echo "environment = \"dev\"" >> terraform.tfvars'
                    sh 'echo "availability_zones = [${REGION}a, ${REGION}b]" >> terraform.tfvars'
                    sh 'echo "vpc_cidr = \"10.0.0.0/16\"" >> terraform.tfvars'
                    sh 'echo "public_subnet_cidrs = [\"10.0.1.0/24\", \"10.0.2.0/24\"]" >> terraform.tfvars'
                    sh 'echo "private_subnet_cidrs = [\"10.0.101.0/24\", \"10.0.102.0/24\"]" >> terraform.tfvars'
               }
            }
        }

        stage('Terraform Init') {
            steps {
                script {
                    // Initialize Terraform with backend configuration
                    sh '''
                    terraform init -backend-config="terraform.tfbackend"
                    '''
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                script {
                    // Generate and show an execution plan
                    sh '''
                    terraform plan -var-file=terraform.tfvars
                    '''
                }
            }
        }
        
        stage('Terraform Validate') {
            steps {
                script {
                    // Generate and show an execution plan
                    sh '''
                    terraform validate
                    '''
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                script {
                    // Apply the plan to provision resources
                    sh '''
                    terraform apply -auto-approve
                    '''
                }
            }
        }

        stage('Terraform Output') {
            steps {
                script {
                    // Fetch the outputs from Terraform
                    sh '''
                    terraform output
                    '''
                }
            }
        }
    }

    post {
        always {
            // Clean workspace
            sh "rm -rf terraform.tfbackend terraform.tfvars"
            deleteDir()
            cleanWs()
        }
    }
}
